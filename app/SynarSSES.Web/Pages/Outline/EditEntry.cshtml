@page
@model SynarSSES.Web.Pages.Outline.EditEntryModel
@{
    ViewData["Title"] = Model.IsNew ? "New Entry" : "Edit Entry";
}

<div class="row">
    <div class="col-md-9 mx-auto">
        <h1 class="display-6 mb-1">@(Model.IsNew ? "New Entry" : "Edit Entry")</h1>
        <p class="text-muted">in section <strong>@Model.SectionTitle</strong></p>

        <form method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="SectionId" />
            <div class="row g-3">
                <div class="col-md-2">
                    <label asp-for="Year" class="form-label">Year</label>
                    <input asp-for="Year" type="number" min="2000" max="2099" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="CompletedOn" class="form-label">Completed on</label>
                    <input asp-for="CompletedOn" type="date" class="form-control" />
                </div>
                <div class="col-md-5">
                    <label asp-for="Label" class="form-label">Label</label>
                    <input asp-for="Label" class="form-control" required
                           placeholder="e.g. ABC list provided" />
                </div>
                <div class="col-md-2">
                    <label asp-for="SortOrder" class="form-label">Sort Order</label>
                    <input asp-for="SortOrder" type="number" class="form-control" />
                </div>
            </div>
            <div class="mt-3">
                <label asp-for="NotesMd" class="form-label">Notes (Markdown, optional)</label>
                <textarea asp-for="NotesMd" class="form-control font-monospace" rows="6"></textarea>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-link" asp-page="Index">Cancel</a>
            </div>
            <div asp-validation-summary="All" class="text-danger mt-3"></div>
        </form>
    </div>
</div>
