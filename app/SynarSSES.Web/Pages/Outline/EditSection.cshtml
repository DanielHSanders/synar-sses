@page
@model SynarSSES.Web.Pages.Outline.EditSectionModel
@{
    ViewData["Title"] = Model.IsNew ? "New Section" : "Edit Section";
}

<div class="row">
    <div class="col-md-9 mx-auto">
        <h1 class="display-6 mb-3">@(Model.IsNew ? "New Section" : "Edit Section")</h1>

        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label">Title</label>
                    <input asp-for="Title" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <label asp-for="SortOrder" class="form-label">Sort Order</label>
                    <input asp-for="SortOrder" type="number" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="DateRange" class="form-label">Date Range</label>
                    <input asp-for="DateRange" class="form-control" placeholder="Feb-Mar" />
                </div>
            </div>
            <div class="mt-3">
                <label asp-for="BodyMd" class="form-label">Body (Markdown)</label>
                <textarea asp-for="BodyMd" class="form-control font-monospace" rows="14"></textarea>
                <div class="form-text">
                    Supports headings (<code>###</code>), bold (<code>**bold**</code>),
                    lists, and links (<code>[text](https://...)</code> or just bare URLs).
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-link" asp-page="Index">Cancel</a>
            </div>
            <div asp-validation-summary="All" class="text-danger mt-3"></div>
        </form>
    </div>
</div>
